# 统一换行：仓库与工作区均 LF（Windows 下 .bat/.cmd 例外保 CRLF）
* text=auto eol=lf

# 脚本显式声明
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.db binary
*.sqlite binary
*.pyc binary
*.exe binary
*.woff binary
*.woff2 binary
